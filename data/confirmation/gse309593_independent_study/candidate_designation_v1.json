  "access_sequence": [
    "publish and independently verify this designation tag",
    "close GSE288020 development and publish the frozen source estimator and all four comparator configurations",
    "RNA stage: fetch and hash one designated GSE309593 H5 at a time; read no ADT file; verify RNA schema and support, choose 512 common-identifier candidates by the frozen hash rule, and derive RNA states and margins",
    "ADT stage: after publishing the RNA-stage artifact, fetch and hash one designated ADT CSV at a time; the ADT process may read selected identifiers and ADT counts but may not read recipient RNA states; derive ADT ranks and margins",
    "prediction stage: reconstruct each method at recipient RNA and ADT margins and publish the complete prediction artifact before any recipient RNA-to-ADT joint table is formed",
    "score stage: only after independent prediction-tag verification, join selected RNA and ADT states, form joint tables, and score once"
  ],
  "states_and_sampling": {
    "cells_per_subject": 512,
    "rna_state": "raw UMI count greater than zero",
    "adt_state": "deterministic within-subject midrank split into 256 low and 256 high cells",
    "cell_selection_salt": "GSE309593-CELL-BUDGET-v1",
    "adt_tie_salt": "GSE309593-ADT-MIDRANK-v1",
    "destroyed_link_salt": "GSE309593-SOURCE-DESTROYED-LINK-v1"
  },
  "comparisons": {
    "primary_estimator": "hierarchical exact fixed-margin conditional coupling field fitted to GSE288020",
    "matched_residual": "the GSE288020-selected signed-root Poisson-deviance residual transfer, reconstructed at the same GSE309593 margins",
    "destroyed_link": "the same primary estimator refitted after one frozen within-source-subject permutation of complete ADT profiles",
    "common_exact": "one unpenalized exact fixed-margin common log odds per entity across GSE288020 source subjects",
    "pooled_saturated_poisson": "one interaction coefficient from the saturated row-plus-column-plus-interaction Poisson model fitted to each GSE288020 donor-pooled table",
    "fairness": "all methods use the same retained marker panel, source subjects, recipient subjects, selected cells, recipient margins, loss, and source-only selection boundary"
